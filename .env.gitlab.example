# Copy this file to .env.gitlab and replace the placeholder token.
# .env.gitlab is ignored by Git; never commit or paste its token into logs.
GITLAB_BASE_URL=https://developer.allgofree.org
GITLAB_PROJECT=dragonwilds/zanik
GITLAB_TOKEN=glpat-replace-with-a-read-api-token
GITLAB_POLL_SECONDS=10
GITLAB_TIMEOUT_SECONDS=1800
