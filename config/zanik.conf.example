# Zanik configuration. Values are parsed as data; this file is never sourced.
# Unknown keys and malformed values disable Zanik while still launching the game.

# Master switch. false launches the official game server without loading Zanik.
# Installed files, configuration, generated assets, and persistent data are preserved.
ZANIK_ENABLED=true

# Use a separately allocated/open TCP port, never the Dragonwilds game port.
STATUS_PORT=29105
# The externally reachable website URL, including its public port when needed.
PUBLIC_BASE_URL=http://127.0.0.1:29105
ADMIN_COOKIE_NAME=zanik_admin

# Read-only features default on.
FEATURE_PLAYER_STATUS=true
FEATURE_KILL_TRACKING=true
FEATURE_MAP=true
FEATURE_RESOURCE_TRACKING=true
FEATURE_NPC_TRACKING=true
FEATURE_PLAYER_RECIPE_TRACKING=true
FEATURE_PLAYER_QUEST_TRACKING=true
FEATURE_ADMIN_READ=true

# State-changing and gameplay features default off.
FEATURE_ADMIN_RECIPE_SETTINGS=false
# Allows authenticated player, player-built lodestone, fixed nodestone, storage, and gravestone teleports.
FEATURE_ADMIN_TELEPORT=false
FEATURE_ADMIN_STORAGE_MUTATION=false
FEATURE_ADMIN_GRAVESTONE_MUTATION=false
# Incomplete and not deployable yet. Keep this false.
FEATURE_QOL_AUTO_COMPOST=false
