#!/bin/sh
set -u

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ZANIK_DIR=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
. "$ZANIK_DIR/lib/zanik-common.sh"

server_root=${ZANIK_SERVER_ROOT:-$(CDPATH= cd -- "$ZANIK_DIR/.." && pwd)}
config_path=${ZANIK_CONFIG:-$ZANIK_DIR/config/zanik.conf}
install_mode=${ZANIK_INSTALL_MODE:-wrapper}
env_ZANIK_ENABLED=${ZANIK_ENABLED-}
env_STATUS_PORT=${ZANIK_STATUS_PORT-}
env_PUBLIC_BASE_URL=${ZANIK_PUBLIC_BASE_URL-}
env_ADMIN_COOKIE_NAME=${ZANIK_ADMIN_COOKIE_NAME-}
env_FEATURE_PLAYER_STATUS=${ZANIK_FEATURE_PLAYER_STATUS-}
env_FEATURE_KILL_TRACKING=${ZANIK_FEATURE_KILL_TRACKING-}
env_FEATURE_MAP=${ZANIK_FEATURE_MAP-}
env_FEATURE_RESOURCE_TRACKING=${ZANIK_FEATURE_RESOURCE_TRACKING-}
env_FEATURE_NPC_TRACKING=${ZANIK_FEATURE_NPC_TRACKING-}
env_FEATURE_PLAYER_RECIPE_TRACKING=${ZANIK_FEATURE_PLAYER_RECIPE_TRACKING-}
env_FEATURE_PLAYER_QUEST_TRACKING=${ZANIK_FEATURE_PLAYER_QUEST_TRACKING-}
env_FEATURE_ADMIN_READ=${ZANIK_FEATURE_ADMIN_READ-}
env_FEATURE_ADMIN_RECIPE_SETTINGS=${ZANIK_FEATURE_ADMIN_RECIPE_SETTINGS-}
env_FEATURE_ADMIN_TELEPORT=${ZANIK_FEATURE_ADMIN_TELEPORT-}
env_FEATURE_ADMIN_STORAGE_MUTATION=${ZANIK_FEATURE_ADMIN_STORAGE_MUTATION-}
env_FEATURE_ADMIN_GRAVESTONE_MUTATION=${ZANIK_FEATURE_ADMIN_GRAVESTONE_MUTATION-}
env_FEATURE_QOL_AUTO_COMPOST=${ZANIK_FEATURE_QOL_AUTO_COMPOST-}

while [ $# -gt 0 ]; do
  case "$1" in
    --config) [ $# -ge 2 ] || { zanik_log '--config requires a path'; exit 2; }; config_path=$2; shift 2;;
    --server-root) [ $# -ge 2 ] || { zanik_log '--server-root requires a path'; exit 2; }; server_root=$2; shift 2;;
    --) shift; break;;
    *) zanik_log "Unknown launcher option: $1"; exit 2;;
  esac
done

game=$(zanik_game_path "$server_root")
if [ "$install_mode" = replace-executable ]; then game=$game.zanik-original; fi
[ -x "$game" ] || { zanik_log "Official server executable not found or not executable: $game"; exit 1; }

zanik_defaults
if ! zanik_load_config "$config_path"; then
  zanik_log 'Configuration is invalid; starting the official server without Zanik.'
  export ZANIK_CONFIG_VALID=0
  exec "$game" "$@"
fi
apply_override(){
  [ -z "$2" ] && return 0
  if ! zanik_set_config "$1" "$2"; then
    zanik_log "Invalid ZANIK_$1 override; starting the official server without Zanik."
    return 1
  fi
}
if ! apply_override ZANIK_ENABLED "$env_ZANIK_ENABLED" ||
   ! apply_override STATUS_PORT "$env_STATUS_PORT" ||
   ! apply_override PUBLIC_BASE_URL "$env_PUBLIC_BASE_URL" ||
   ! apply_override ADMIN_COOKIE_NAME "$env_ADMIN_COOKIE_NAME" ||
   ! apply_override FEATURE_PLAYER_STATUS "$env_FEATURE_PLAYER_STATUS" ||
   ! apply_override FEATURE_KILL_TRACKING "$env_FEATURE_KILL_TRACKING" ||
   ! apply_override FEATURE_MAP "$env_FEATURE_MAP" ||
   ! apply_override FEATURE_RESOURCE_TRACKING "$env_FEATURE_RESOURCE_TRACKING" ||
   ! apply_override FEATURE_NPC_TRACKING "$env_FEATURE_NPC_TRACKING" ||
   ! apply_override FEATURE_PLAYER_RECIPE_TRACKING "$env_FEATURE_PLAYER_RECIPE_TRACKING" ||
   ! apply_override FEATURE_PLAYER_QUEST_TRACKING "$env_FEATURE_PLAYER_QUEST_TRACKING" ||
   ! apply_override FEATURE_ADMIN_READ "$env_FEATURE_ADMIN_READ" ||
   ! apply_override FEATURE_ADMIN_RECIPE_SETTINGS "$env_FEATURE_ADMIN_RECIPE_SETTINGS" ||
   ! apply_override FEATURE_ADMIN_TELEPORT "$env_FEATURE_ADMIN_TELEPORT" ||
   ! apply_override FEATURE_ADMIN_STORAGE_MUTATION "$env_FEATURE_ADMIN_STORAGE_MUTATION" ||
   ! apply_override FEATURE_ADMIN_GRAVESTONE_MUTATION "$env_FEATURE_ADMIN_GRAVESTONE_MUTATION" ||
   ! apply_override FEATURE_QOL_AUTO_COMPOST "$env_FEATURE_QOL_AUTO_COMPOST"; then
  export ZANIK_CONFIG_VALID=0
  exec "$game" "$@"
fi

if [ "$CFG_ZANIK_ENABLED" -eq 0 ]; then
  zanik_log 'Zanik is disabled by configuration; starting the official server without Zanik.'
  exec "$game" "$@"
fi

mkdir -p "$server_root/zanik-data" "$ZANIK_DIR/state"
chmod 700 "$server_root/zanik-data"
# ZANIK_ASSET_DELTA_ON_START=1
# Asset updates are already followed by a restart. Applying a staged delta
# before the game starts avoids depending on panel console-input forwarding
# and combines activation with that single restart.
pending_asset_delta="$ZANIK_DIR/state/pending-asset-delta"
# Pterodactyl's file API may reject directory symlink traversal. Migrate any
# earlier delta-created current symlink back to the physical directory form
# while the game is stopped during launcher startup.
asset_current="$ZANIK_DIR/assets/current"
if [ -L "$asset_current" ]; then
  asset_link=$(readlink "$asset_current")
  case "$asset_link" in ''|/*|*/*|..*) zanik_log 'Refused an unsafe asset-current symlink migration.' ;;
    *)
      rm -f "$asset_current"
      if ! mv "$ZANIK_DIR/assets/$asset_link" "$asset_current"; then
        ln -s "$asset_link" "$asset_current"
      fi
      ;;
  esac
fi
if [ -f "$pending_asset_delta" ]; then
  IFS= read -r pending_request <"$pending_asset_delta" || pending_request=
  rm -f "$pending_asset_delta"
  case "$pending_request" in
    ''|*[!0-9a-f]*) zanik_log 'Discarded an invalid pending asset delta request.' ;;
    *)
      if [ ${#pending_request} -ge 16 ] && [ ${#pending_request} -le 64 ]; then
        "$ZANIK_DIR/scripts/apply-asset-delta.sh" --server-root "$server_root" \
          --request-id "$pending_request" >/dev/null 2>&1 || true
      fi
      ;;
  esac
fi
zanik_make_secret "$server_root/zanik-data/console-admin.key" || { zanik_log 'Could not create console secret; starting without Zanik.'; exec "$game" "$@"; }
DW_CONSOLE_SECRET=$(tr -d '\r\n' < "$server_root/zanik-data/console-admin.key"); export DW_CONSOLE_SECRET
zanik_export_runtime "$server_root" "$install_mode"
game_sha=$(zanik_sha256 "$game")
game_build=$(awk -F'"' '/"buildid"/{print $4;exit}' "$server_root/steamapps/appmanifest_4019830.acf" 2>/dev/null || true)
case "$game_build" in ''|*[!0-9]*) game_build=unknown;; esac
runtime_state="$ZANIK_DIR/state/runtime-game.json"
runtime_temporary=$runtime_state.new.$$
printf '{"schemaVersion":1,"gameBuild":"%s","officialSha256":"%s","installMode":"%s","observedAt":"%s"}\n' \
  "$game_build" "$game_sha" "$install_mode" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$runtime_temporary"
chmod 600 "$runtime_temporary"
mv -f "$runtime_temporary" "$runtime_state"
if ! awk -F '\t' -v expected="$game_sha" 'BEGIN{found=0} $1==expected{found=1} END{exit found?0:1}' "$ZANIK_DIR/compatibility.tsv"; then
  ZANIK_INSTALLED_VERSION=$(tr -d '\r\n' < "$ZANIK_DIR/VERSION"); export ZANIK_INSTALLED_VERSION
  ZANIK_GAME_BUILD_ID=$game_build
  export ZANIK_GAME_BUILD_ID
  ZANIK_AUTO_UPDATE_VALUE=${AUTO_UPDATE-unknown}; export ZANIK_AUTO_UPDATE_VALUE
  if [ "$install_mode" = replace-executable ]; then
    if [ "$ZANIK_AUTO_UPDATE_VALUE" = 0 ]; then ZANIK_AUTO_UPDATE_HEALTH=healthy; else ZANIK_AUTO_UPDATE_HEALTH=unhealthy; fi
  else
    ZANIK_AUTO_UPDATE_HEALTH=preserved
  fi
  export ZANIK_AUTO_UPDATE_HEALTH
  export ZANIK_MAINTENANCE_MODE=1
  export ZANIK_GAME_EXECUTABLE_SHA256=$game_sha
  export DW_MAINTENANCE_RELEASE_STATE="$ZANIK_DIR/state/maintenance-release.json"
  (while :; do
    "$ZANIK_DIR/scripts/check-compatible-release.sh" --executable-sha256 "$game_sha" \
      --output "$DW_MAINTENANCE_RELEASE_STATE" >/dev/null 2>&1 || true
    sleep 600
  done) &
  maintenance_check_pid=$!
  zanik_log "Dragonwilds executable $game_sha is not in this Zanik release; native features are disabled and the maintenance website will be served."
fi
game_preload="$ZANIK_DIR/bin/libzanik.so${LD_PRELOAD:+:$LD_PRELOAD}"

# Pterodactyl delivers console input on stdin. Keep the game on a private FIFO
# so Zanik can consume its one administrative command without swallowing or
# reinterpreting ordinary server commands. The proxy secret is sent only to
# the loopback API and is never included in console output.
console_fifo="$ZANIK_DIR/state/console-input.$$"
if ! mkfifo "$console_fifo"; then
  LD_PRELOAD=$game_preload; export LD_PRELOAD
  exec "$game" "$@"
fi
exec 3<>"$console_fifo"
env LD_PRELOAD="$game_preload" "$game" "$@" <&3 &
game_pid=$!
cleanup(){
  kill "$game_pid" 2>/dev/null || true
  wait "$game_pid" 2>/dev/null || true
  if [ -n "${maintenance_check_pid-}" ]; then kill "$maintenance_check_pid" 2>/dev/null || true; wait "$maintenance_check_pid" 2>/dev/null || true; fi
  rm -f "$console_fifo"
}
trap cleanup INT TERM EXIT
while kill -0 "$game_pid" 2>/dev/null && IFS= read -r command; do
  case "$command" in
    zanik-player-id|zanik-player-id\ *)
      requested=${command#zanik-player-id}; requested=${requested# }
      response=$(curl -fsS --max-time 5 -X POST -H "X-Zanik-Console-Key: $DW_CONSOLE_SECRET" --data-binary "$requested" "http://127.0.0.1:$CFG_STATUS_PORT/api/admin/console-player-ids" 2>/dev/null || true)
      if [ -n "$response" ]; then printf '%s\n' "$response" | while IFS= read -r line; do zanik_log "$line"; done; else zanik_log 'Could not read known player IDs.'; fi
      ;;
    zanik-admin\ *)
      requested=${command#zanik-admin }
      response=$(curl -fsS --max-time 5 -X POST -H "X-Zanik-Console-Key: $DW_CONSOLE_SECRET" --data-binary "$requested" "http://127.0.0.1:$CFG_STATUS_PORT/api/admin/console-claim" 2>/dev/null || true)
      url=$(printf '%s' "$response" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
      if [ -n "$url" ]; then zanik_log "Admin login for $requested (expires in 5 minutes): $url"; else zanik_log "Could not create an admin login link for the requested character."; fi
      ;;
    zanik-admin)
      zanik_log 'Usage: zanik-admin <public-character-id>'
      ;;
    zanik-doctor-assets\ *)
      request_id=${command#zanik-doctor-assets }
      case "$request_id" in
        ''|*[!0-9a-f]*)
          zanik_log 'Usage: zanik-doctor-assets <request-id>'
          ;;
        *)
          if [ ${#request_id} -gt 64 ]; then
            zanik_log 'Usage: zanik-doctor-assets <request-id>'
          else
            report="$ZANIK_DIR/state/asset-verification-$request_id.json"
            rm -f "$report"
            "$ZANIK_DIR/scripts/verify-assets.sh" "$ZANIK_DIR/assets/current" "$report" "$request_id" >/dev/null 2>&1 &
            zanik_log "Started server-side asset verification request $request_id."
          fi
          ;;
      esac
      ;;
    zanik-doctor-assets)
      zanik_log 'Usage: zanik-doctor-assets <request-id>'
      ;;
    zanik-check-game-update\ *)
      request_id=${command#zanik-check-game-update }
      case "$request_id" in
        ''|*[!0-9a-f]*) zanik_log 'Usage: zanik-check-game-update <request-id>' ;;
        *)
          if [ ${#request_id} -lt 16 ] || [ ${#request_id} -gt 64 ]; then
            zanik_log 'Usage: zanik-check-game-update <request-id>'
          else
            "$ZANIK_DIR/scripts/check-game-update.sh" --server-root "$server_root" --request-id "$request_id" >/dev/null 2>&1 &
            zanik_log "Started read-only Dragonwilds update check $request_id."
          fi
          ;;
      esac
      ;;
    zanik-check-game-update)
      zanik_log 'Usage: zanik-check-game-update <request-id>'
      ;;
    zanik-apply-asset-delta\ *)
      request_id=${command#zanik-apply-asset-delta }
      case "$request_id" in
        ''|*[!0-9a-f]*) zanik_log 'Usage: zanik-apply-asset-delta <request-id>' ;;
        *)
          if [ ${#request_id} -lt 16 ] || [ ${#request_id} -gt 64 ]; then
            zanik_log 'Usage: zanik-apply-asset-delta <request-id>'
          else
            "$ZANIK_DIR/scripts/apply-asset-delta.sh" --server-root "$server_root" --request-id "$request_id" >/dev/null 2>&1 &
            zanik_log "Started atomic asset delta activation $request_id."
          fi
          ;;
      esac
      ;;
    zanik-apply-asset-delta)
      zanik_log 'Usage: zanik-apply-asset-delta <request-id>'
      ;;
    *) printf '%s\n' "$command" >&3;;
  esac
done
wait "$game_pid"; result=$?
trap - INT TERM EXIT
rm -f "$console_fifo"
exit "$result"
